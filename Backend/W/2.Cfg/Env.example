# Orbe · runtime config (template — copy to .env, fill values)
# Loaded by gate::Surreal at startup; never committed.

# SurrealDB connection (ws for queries + live queries; http for import/migrations)
SURREAL_URL=ws://localhost:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=orbe
SURREAL_DB=inventory

# HTTP server bind address (read by Dioxus.toml [serve] and by `cargo run`)
ORBE_PORT=8080

# Log filter (tracing-subscriber EnvFilter syntax)
RUST_LOG=info,orbe_api=debug,tower_http=info

# Phase 2+: auth, billing, telemetry keys go here
# SURREAL_TOKEN=...       # root key, never use root in prod
# SENTRY_DSN=...
